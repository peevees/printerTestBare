{
    "manifest_version": 2,
    "name": "printerTest",
    "version": "0.0.1",
    "description": "Registers a virtual test printer and traces every printerProvider event",
    "short_name": "ptest",
    "permissions": [
        "printerProvider",
        "storage"
    ],
    "background": {
        "scripts": [
            "trace.js",
            "background.js"
        ],
        "persistent": true
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "128": "icons/icon128.png"
    }
}
