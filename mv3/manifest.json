{
    "manifest_version": 3,
    "name": "printerTest",
    "version": "0.0.1",
    "description": "Registers a virtual test printer and traces every printerProvider event",
    "short_name": "ptest",
    "permissions": [
        "printerProvider",
        "storage"
    ],
    "background": {
        "service_worker": "background-wrapper.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "128": "icons/icon128.png"
    }
}
